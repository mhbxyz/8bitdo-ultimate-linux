# 8BitDo, user access to the USB devices and the hidraw nodes
#
# In Xbox mode the 8BitDo Ultimate 3-mode (2dc8:2030) exposes the XGIP interface
# (ff/47/d0): no hidraw node is created. To talk to the pad (detach xpad, send the
# "knock" that switches it to configuration mode), the user must be allowed to
# open the usbfs node /dev/bus/usb/BBB/DDD.
#
# TAG+="uaccess" alone is not used: the ACL depends on systemd-logind and on an
# active seat session, which is not always the case here. The `input` group is
# more deterministic (the user is already in it).
#
# Installation: sudo ./scripts/setup-permissions.sh

# All 8BitDo USB devices (any PID, the pad changes PID in configuration mode)
SUBSYSTEM=="usb", ATTR{idVendor}=="2dc8", MODE="0660", GROUP="input"
SUBSYSTEM=="usb", ATTR{idVendor}=="2dc8", TAG+="uaccess"

# hidraw nodes of the HID modes (config / DInput / 2.4G dongle)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2dc8", MODE="0660", GROUP="input"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2dc8", TAG+="uaccess"

# Input nodes (joystick/event): keeps the XInput reports drained
SUBSYSTEM=="input", ATTRS{idVendor}=="2dc8", MODE="0660", GROUP="input"
